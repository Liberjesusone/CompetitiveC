{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run/Debug archivo actual (C++ o Rust)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.run/current.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        { "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "build-current"
    }
  ]
}
