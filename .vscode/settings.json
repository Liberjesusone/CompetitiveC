{
    "C_Cpp.errorSquiggles": "enabled",
    "cmake.generator": "Ninja",
    "cmake.configureOnOpen": true,
    "cmake.configureArgs": ["-DCMAKE_BUILD_TYPE=Debug"],

    // Error Lens: NO mostrar los mensajes en linea dentro de archivos .md
    "errorLens.excludePatterns": ["**/*.{md,rs}"],

    // rust-analyzer: says which especifically is the Cargo project (the root one) 
    "rust-analyzer.linkedProjects": ["./Cargo.toml"],
    // Avoids the rust-analyzer from "guessing" individual files: uses only the Cargo.toml. 
    "rust-analyzer.cargo.allTargets": true
}